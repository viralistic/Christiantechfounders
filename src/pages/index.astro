---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Plus from '@/components/Plus.astro';
import FlowLines from '@/components/FlowLines.astro';

const pillars = [
  {
    n: '01',
    t: 'Je idee krijgt techniek.',
    b: 'Een goed idee strandt zelden op overtuiging. Het strandt op techniek die er niet is. Wij bouwen dat stuk mee.',
  },
  {
    n: '02',
    t: 'Je bouwt niet in je eentje.',
    b: 'Je zit in een kamer met mensen die je taal spreken — technisch én geloofsmatig. Niemand hoeft iets uit te leggen.',
  },
  {
    n: '03',
    t: 'Je blijft niet hangen in plannen.',
    b: 'We werken projectgedreven. Je gaat naar huis met iets dat af is, of in elk geval opgeschoten.',
  },
];
---
<Base
  title="Christian Tech Founders — Christelijke ideeën, mogelijk gemaakt."
  description="We geven christelijke ideeën de technologie die ze nodig hebben, en zorgen dat je het niet alleen hoeft te doen."
  current="home"
>
  <!-- HERO -->
  <section class="ctf-shell" style="padding-top:24px;">
    <div class="ctf-card hero-card">
      <FlowLines intensity={0.45} />
      <div class="hero-inner">
        <span class="ctf-eyebrow-row fx-rise" style="margin-bottom:28px;">
          Voor christelijke bouwers en denkers
        </span>
        <h1 class="hero-title">
          <span class="fx-rise-lg" style="display:block;">Christelijke ideeën,</span>
          <span class="fx-rise-lg" style="display:block;">
            mogelijk gemaakt<span class="hero-dot">.</span>
          </span>
        </h1>
        <p class="hero-lede fx-rise">
          We geven christelijke ideeën de technologie die ze nodig hebben om te
          bestaan. En we zorgen dat je het niet alleen hoeft te doen.
        </p>
        <div class="hero-cta fx-rise">
          <Button variant="primary" href="/apply" magnet>Aanmelden</Button>
          <span class="hero-or">of</span>
          <Button variant="outline" href="/about">Meer info</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- NOT ALONE — the emotional core, on dark -->
  <section class="alone-wrap">
    <div class="ctf-card-dark alone">
      <div class="alone-inner" data-reveal>
        <span class="ctf-eyebrow-row" style="color: var(--ink-on-dark-3); margin-bottom:32px;">
          Waarom we bestaan
        </span>
        <h2 class="alone-title">Je staat er niet alleen voor.</h2>
        <div class="alone-text">
          <p>
            Er is een moment dat veel christelijke bouwers herkennen. In de kerk
            snapt niemand precies wat je maakt. In tech snapt niemand precies
            waarom het je zoveel doet.
          </p>
          <p>
            Dat is geen karakterfout en geen fase. Het is gewoon eenzaam. En het
            is de reden dat goede ideeën in hoofden blijven zitten in plaats van
            gebouwd te worden.
          </p>
          <p class="alone-punch">
            Er zijn er meer zoals jij. Je hebt ze alleen nog niet ontmoet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="ctf-shell" style="margin-top:24px;">
    <div class="ctf-card ctf-dots pillars-card">
      <div class="ctf-wrap">
        <span class="ctf-eyebrow-row" style="margin-bottom:32px;" data-reveal>Wat we doen</span>
        <h2 class="pillars-title" data-reveal>
          Ideeën mogelijk maken,<br />
          met mensen om je heen.
        </h2>
        {pillars.map((p) => (
          <div class="ctf-step" data-reveal>
            <div class="ctf-step-num">{p.n}</div>
            <div>
              <h3 class="pillar-t">{p.t}</h3>
              <p class="pillar-b">{p.b}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BELONGING -->
  <section class="ctf-shell" style="margin-top:24px;">
    <div class="ctf-card belong-card">
      <div class="belong-grid" data-reveal>
        <div>
          <span class="ctf-eyebrow-row" style="margin-bottom:24px;">Voor wie</span>
          <h2 class="belong-title">
            Je hoeft niet te kiezen tussen geloof en techniek.
          </h2>
        </div>
        <div class="ctf-paper belong-side">
          <p>
            <Plus letter="J" />e bouwt iets, of je wilt iets bouwen, en je gelooft
            dat het ergens toe doet.
          </p>
          <p>
            <Plus letter="D" />at is genoeg. We kijken niet naar volgers, titels
            of hoe ver je al bent.
          </p>
          <div class="belong-foot">
            <h4>Dat is de hele toelatingseis</h4>
            <p>De rest bouwen we samen op.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="ctf-shell" style="margin-top:24px;">
    <div class="ctf-card closing-card">
      <FlowLines intensity={0.3} />
      <div class="closing-inner" data-reveal>
        <h2 class="closing-title">
          Klaar om niet meer<br />
          in je eentje te bouwen?
        </h2>
        <p class="closing-lede">
          Aanmelden duurt vijf minuten. We laten binnen een week weten of er fit is.
        </p>
        <div class="closing-cta">
          <Button variant="primary" href="/apply" magnet>Aanmelden</Button>
          <span class="hero-or">of</span>
          <Button variant="outline" href="/vision">Lees onze visie</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero-card { padding: 0; position: relative; overflow: hidden; }
  .hero-inner {
    padding: 168px 80px 128px;
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }
  .hero-title {
    font: var(--t-display-lg); letter-spacing: -0.025em; line-height: 1.02;
    color: var(--ink-1);
    max-width: 16ch;
  }
  .hero-dot { color: var(--ctf-blue); }
  .hero-lede {
    margin-top: 32px; max-width: 560px;
    font: var(--t-serif-body-lg); color: var(--ink-3); line-height: 1.55;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 16px;
    margin-top: 40px; flex-wrap: wrap;
  }
  .hero-or { font: var(--t-serif-body); color: var(--ink-3); font-style: italic; }

  /* Not alone */
  .alone-wrap { margin: 24px; }
  .alone { padding: 120px 64px; }
  .alone-inner { max-width: 860px; margin: 0 auto; }
  .alone-title {
    font: var(--t-display-lg); color: var(--ink-on-dark-1);
    letter-spacing: -0.025em; line-height: 1.04;
  }
  .alone-text { margin-top: 48px; display: grid; gap: 24px; max-width: 640px; }
  .alone-text p {
    font: var(--t-serif-body-lg); color: var(--ink-on-dark-2); line-height: 1.6;
  }
  .alone-punch {
    margin-top: 8px; padding-top: 28px;
    border-top: 1px solid var(--line-on-dark);
    color: var(--ink-on-dark-1) !important;
  }

  /* Pillars */
  .pillars-card { padding: 120px 80px; }
  .ctf-wrap { max-width: 1200px; margin: 0 auto; }
  .pillars-title {
    font: var(--t-display-md); color: var(--ink-1);
    letter-spacing: -0.025em; line-height: 1.05; margin-bottom: 56px;
  }
  .pillar-t { font: var(--t-h3); color: var(--ink-1); letter-spacing: -0.02em; margin-bottom: 12px; }
  .pillar-b { font: var(--t-serif-body); color: var(--ink-2); max-width: 640px; line-height: 1.55; }

  /* Belonging */
  .belong-card { padding: 120px 80px; }
  .belong-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
    max-width: 1200px; margin: 0 auto; align-items: start;
  }
  .belong-title {
    font: var(--t-display-md); color: var(--ink-1);
    letter-spacing: -0.025em; line-height: 1.05;
  }
  .belong-side { padding: 36px 40px; display: grid; gap: 28px; }
  .belong-side p { font: var(--t-serif-body-lg); color: var(--ink-2); line-height: 1.55; }
  .belong-foot { padding-top: 20px; border-top: 1px solid var(--line-1); }
  .belong-foot h4 { font: var(--t-h4); color: var(--ctf-blue); letter-spacing: -0.01em; }
  .belong-foot p {
    margin: 12px 0 0 18px; padding-left: 12px;
    border-left: 1px solid var(--line-2);
    font: var(--t-serif-body-sm); color: var(--ink-3); line-height: 1.55;
  }

  /* Closing */
  .closing-card { padding: 120px 80px; position: relative; }
  .closing-inner { position: relative; max-width: 720px; margin: 0 auto; text-align: center; }
  .closing-title {
    font: var(--t-display-lg); letter-spacing: -0.025em;
    line-height: 1.05; color: var(--ink-1);
  }
  .closing-lede {
    margin-top: 28px; font: var(--t-serif-body-lg); color: var(--ink-3);
    max-width: 520px; margin-left: auto; margin-right: auto;
  }
  .closing-cta {
    margin-top: 40px; display: inline-flex; align-items: center;
    gap: 16px; flex-wrap: wrap; justify-content: center;
  }

  @media (max-width: 1000px) {
    .hero-inner { padding: 112px 32px 80px; }
    .pillars-card, .belong-card, .closing-card { padding: 72px 32px; }
    .belong-grid { grid-template-columns: 1fr; gap: 40px; }
    .alone { padding: 72px 28px; }
    .alone-wrap { margin: 24px 12px; }
  }
</style>
