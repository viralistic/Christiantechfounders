---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Mark from '@/components/Mark.astro';
import FlowLines from '@/components/FlowLines.astro';

// Deliberately anonymous: we show what gets built here, not who built it.
const WORK_SAMPLES = [
  { id: 'w01', builds: 'Infrastructuur voor mid-size SaaS', domain: 'Tooling' },
  { id: 'w02', builds: 'ML-tool voor academisch onderzoek', domain: 'AI' },
  { id: 'w03', builds: 'Ethische AI-evaluatie raamwerken', domain: 'AI' },
  { id: 'w04', builds: 'Platform voor lokale stichtingen', domain: 'Web' },
  { id: 'w05', builds: 'Schaalbare backend-systemen', domain: 'Tooling' },
  { id: 'w06', builds: 'Productontwerp voor vroege fase', domain: 'Web' },
  { id: 'w07', builds: 'Embedded systems voor IoT', domain: 'Hardware' },
  { id: 'w08', builds: 'Diaconaal platform voor kerken', domain: 'Web' },
  { id: 'w09', builds: 'Betalingsplatform voor MKB', domain: 'Fintech' },
  { id: 'w10', builds: 'Data-infrastructuur voor onderzoek', domain: 'Tooling' },
  { id: 'w11', builds: 'Privacy-vriendelijke analytics', domain: 'Tooling' },
  { id: 'w12', builds: 'Open-source signing voor stichtingen', domain: 'Web' },
];
---
<Base
  title="Wat er gebouwd wordt — Christian Tech Founders"
  description="Een greep uit wat er binnen CTF gebouwd wordt. Zonder namen — het gaat om het werk."
  current="founders"
>
  <section class="ctf-shell" style="padding-top:24px;">
    <div class="ctf-card hero-founders">
      <FlowLines intensity={0.4} />
      <div class="hero-inner">
        <span class="ctf-eyebrow-row fx-rise" style="margin-bottom:28px;">Het werk</span>
        <h1 class="hero-title fx-rise-lg">Wat er <Mark>gebouwd</Mark> wordt.</h1>
        <p class="hero-lede fx-rise">
          We zetten hier geen mensen in de etalage. Wel het werk. Dit is een greep
          uit wat er binnen CTF gebouwd wordt — en waar jouw idee tussen past.
        </p>
        <div class="count-pill fx-rise">
          <span class="dot"></span>
          <span>{WORK_SAMPLES.length} lopende projecten</span>
        </div>
      </div>
    </div>
  </section>

  <section class="ctf-shell" style="margin-top:24px;">
    <div class="ctf-card" style="padding:64px 80px 96px;">
      <div class="ctf-wrap">
        <div class="work-grid" data-tilt="4">
          {WORK_SAMPLES.map((w) => (
            <div class="work-card fx-card-hover" data-reveal>
              <div class="work-glyph" aria-hidden="true">+</div>
              <div>
                <p class="work-builds">{w.builds}</p>
              </div>
              <span class="work-domain">{w.domain}</span>
            </div>
          ))}
        </div>
        <p class="footnote">
          Leden blijven bewust anoniem op deze site. Wie er bouwt, hoor je pas als
          je zelf in de kamer zit.
        </p>
      </div>
    </div>
  </section>

  <section class="ctf-shell" style="margin-top:24px; margin-bottom:24px;">
    <div class="ctf-card" style="padding:96px 80px;">
      <div class="cta-grid" data-reveal>
        <p class="cta-text">Iets te bouwen? Meld je aan en zet het op de kaart.</p>
        <Button variant="primary" href="/apply" magnet>Aanmelden</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-founders { padding: 144px 80px 64px; position: relative; overflow: hidden; }
  .hero-inner { position: relative; max-width: 1200px; margin: 0 auto; }
  .hero-title { font: var(--t-display-lg); letter-spacing: -0.025em; line-height: 1.04; color: var(--ink-1); }
  .hero-lede { margin-top: 32px; font: var(--t-serif-body-lg); color: var(--ink-3); max-width: 640px; }
  .count-pill { margin-top: 32px; display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border: 1px solid var(--line-1); border-radius: var(--r-pill); background: var(--bg-paper); }
  .count-pill .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--ctf-blue); }
  .count-pill span:last-child { font: var(--t-body-sm); color: var(--ink-1); }

  .ctf-wrap { max-width: 1200px; margin: 0 auto; }
  .work-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .work-card { background: var(--bg-paper); border: 1px solid var(--line-1); border-radius: var(--r-lg); padding: 24px; display: flex; flex-direction: column; gap: 20px; transition: box-shadow 240ms ease, transform 240ms ease; }
  .work-glyph { aspect-ratio: 1/1; border-radius: var(--r-md); background: var(--ink-5); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 48px; line-height: 1; color: var(--ctf-blue); }
  .work-builds { font: var(--t-serif-body); color: var(--ink-1); line-height: 1.5; }
  .work-domain { align-self: flex-start; padding: 4px 10px; border: 1px solid var(--line-1); border-radius: var(--r-pill); font: var(--t-caption); color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.08em; }

  .footnote { margin: 56px auto 0; font: var(--t-serif-body); color: var(--ink-3); max-width: 640px; text-align: center; }

  .cta-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: center; }
  .cta-text { font: var(--t-display-sm); color: var(--ink-1); letter-spacing: -0.025em; line-height: 1.3; }

  @media (max-width: 1000px) {
    .hero-founders { padding: 96px 32px 48px; }
    .work-grid { grid-template-columns: 1fr 1fr; }
    .cta-grid { grid-template-columns: 1fr; }
  }
</style>
